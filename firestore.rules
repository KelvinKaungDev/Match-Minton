rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Per-user data ─────────────────────────────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Root-level collections (existing) ────────────────────────────────────
    match /session/{docId} {
      allow read, write: if request.auth != null;
    }
    match /players/{playerId} {
      allow read, write: if request.auth != null;
    }
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    // ── Competition sessions ──────────────────────────────────────────────────
    // Public read so judges + scoreboard viewers can look up codes without login.
    // Write requires auth and the uid must match the session owner.
    match /competitionSessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;

      // Court sub-documents: public read + write for UAT
      // (judges update scores without logging in).
      // Replace write rule with a signed-token check when adding Stripe.
      match /courts/{courtId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
